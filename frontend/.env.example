# Contract address on the active chain. Defaults to a placeholder while
# the contract is being deployed. Set to the deployed hex address before
# shipping live.
VITE_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000

# Network: "studionet" (default, gas-free) or "bradbury" (real consensus).
VITE_NETWORK=studionet

# Mock data toggle. When "false" the service layer uses in-memory fixtures
# so the UI is fully demoable while the contract is being deployed.
# Flip to "true" once VITE_CONTRACT_ADDRESS points at a live contract.
VITE_IS_DEPLOYED=false