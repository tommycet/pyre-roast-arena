# ============================================================================
# PYRE — comprehensive .gitignore
# Last audited: 2026-06-20 (post-secret-leak incident)
# Goal: ANY secret committed by accident → automatically excluded on next push.
# ============================================================================

# ---- SECRETS: never commit under any circumstance ----
.secrets/
*.env
.env
.env.*
!.env.example
!.env.template
*.key
*.pem
*.p12
*.pfx
keystores/
*.keystore.json
wallet.json
wallets/
mnemonic*
seed*
*private*
*PRIVATE*

# ---- Vercel / cloud deploy state ----
.vercel/
.netlify/
.aws/
.gcloud/

# ---- Build artifacts ----
node_modules/
dist/
build/
out/
.next/
.turbo/
*.tsbuildinfo

# ---- Walkthrough / recording artifacts ----
walkthrough/out/
walkthrough/out_raw*.log
walkthrough/sessions/
walkthrough/.tmp/
*.mp4
!docs/media/*.mp4
*.webm
*.mkv
recordings/

# ---- Test / coverage artifacts ----
coverage/
.nyc_output/
*.lcov
.pytest_cache/
.tox/
htmlcov/
junit.xml
test-results/

# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
.python-version

# ---- Logs ----
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---- OS / editor cruft ----
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo
*~

# ---- Local dev overrides ----
.env.local
.env.development
.env.production
.env.staging

# ---- Vite / build ----
.vite/
*.local

# ---- Generated docs assets (keep canonical only) ----
docs/screenshots/live-*.png
